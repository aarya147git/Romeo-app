# ==============================================================================
# ROMEO - CLOUD DATABASE & VERCEL CONFIGURATION
# ==============================================================================

# MongoDB Atlas connection string (Standard SRV URI)
# 1. Sign up at https://cloud.mongodb.com
# 2. Create a free M0 cluster
# 3. Under Network Access: add IP 0.0.0.0/0 (Allows Vercel Serverless Functions)
# 4. Under Database Access: create a user and password
# 5. Paste the connection string below:
MONGODB_URI=mongodb+srv://romeo_user:yourPasswordHere@cluster0.mongodb.net/romeo?retryWrites=true&w=majority&appName=RomeoCluster

# Port for local development (defaults to 3000)
PORT=3000

# Google Gemini API Key (Optional: for AI Assistant & Natural Language Search)
GEMINI_API_KEY=your_gemini_api_key_here

# Mode
NODE_ENV=development
